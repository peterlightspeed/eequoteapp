# ---------- LOCAL TESTING: copy to .env. For the cloud, put the same names in Render > Environment (see GUIDE.md) ----------
APP_ENV=development
DATABASE_URL=sqlite:///./local.db
JWT_SECRET=REPLACE-with-a-long-random-string
JWT_HOURS=8
MAX_LOGIN_ATTEMPTS=3
LOGIN_RATE_PER_MIN=10
MIN_PASSWORD_LEN=10
ENABLE_DOCS=true

SUPERADMIN_EMAIL=you@example.com
SUPERADMIN_PASSWORD=ChangeThis12345

DEFAULT_MARGIN=0.20
DEFAULT_VAT=0.075
DEFAULT_FX=1400
ROUND_LINES=false

# Quote reference: INV/EESOL/20261104_2603
REF_PREFIX=INV/EESOL
REF_SEQ_START=1
QUOTE_VALID_DAYS=15
QUOTE_PAGE=A4

# Printed on the quote (defaults already match EE's template; set only what you want to change)
COMPANY_NAME=EE Solutions Limited
AUTHORIZED_BY=Babajide Padonu
# PREPARED_BY=
# PREPARED_ROLE=
# PREPARED_EMAIL=
# PREPARED_PHONE=
# COMPANY_RC=1848259
# COMPANY_ADDRESS=4,(Plot 1063), Abagbon Close, off Ologun Agbaje Street,|Victoria Island, Lagos Nigeria
# OFFICE_ADDRESS=4, (Plot 1063), Abagbon Close,|Off Ologun Agbaje Street,|Off Adeola Odeku Street,|Victoria Island|Lagos - Nigeria
# TRAINING_ADDRESS=2nd Floor,|60, Akerele Street,|Surulere|Lagos Mainland|Lagos - Nigeria

# Cloud / production only
# ALLOWED_HOSTS=ee-quotes.onrender.com,ee-quotes.vercel.app
# CORS_ORIGINS=
